{
    "version": 2,
    "functions": {
        "api/**/*.ts": { "maxDuration": 60 }
    },
    "crons": [
        {
            "path": "/api/cron/reminders",
            "schedule": "0 6 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/e/:id",
            "destination": "/api/events?action=og&id=:id"
        }
    ]
}
