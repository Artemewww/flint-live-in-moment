# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Token
ADMIN_TOKEN=flint-admin-2026

# Telegram Bot
# Значение ниже — плейсхолдер. Реальный бот @campsflint_bot (id 8697211974)
# живёт только в Vercel Env; прежний токен в этом файле давно протух (401).
TELEGRAM_BOT_TOKEN=000000000:REPLACE_ME
TELEGRAM_WEBHOOK_SECRET=flint_hook_7Kp2mQx9
TELEGRAM_ADMIN_CHAT_ID=-1003935660570
TELEGRAM_BOT_USERNAME=campsflint_bot

# ИИ-помощник организатора (автозаполнение события, программа, список закупки)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Закрытый клуб (шлюз). Пусто = выключен, прод работает как открытая афиша.
VITE_GATE_ENABLED=
GATE_ENABLED=

# Vercel Cron (api/cron/reminders.ts, ежедневно в 09:00).
# Vercel сам шлёт этот секрет в Authorization — задай его, иначе крон
# сможет дёрнуть кто угодно (фолбэк-проверка идёт по ADMIN_TOKEN).
CRON_SECRET=

# Optional: Google Sheets
# GOOGLE_SHEET_ID=your_sheet_id
# GOOGLE_SERVICE_ACCOUNT_CREDENTIALS={"type":"service_account",...}
