# ─────────────────────────────────────────────────────────────
# Telegram-бот ↔ сайт. Задаются в Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Токен бота от @BotFather. Нужен, чтобы заявки с сайта доставлялись в Telegram
# и чтобы проверялась подпись Mini App (initData).
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."

# Куда слать заявки: chat_id администратора или группы заявок.
# Узнать можно, написав боту @userinfobot или через getUpdates.
TELEGRAM_ADMIN_CHAT_ID="123456789"

# Секрет вебхука: любая случайная строка. Защищает /api/telegram/webhook и
# используется как ?key= для одноразовой настройки /api/telegram/setup.
TELEGRAM_WEBHOOK_SECRET="flint_change_me_9f3k2xQ"
