      <section id="app" class="relative py-32 px-5 scroll-mt-20 bg-surface/30 border-y border-white/[0.06] overflow-hidden">
        <!-- контурная молния-платформа: энергия, что держит рутину -->
        <svg class="bolt bolt-flicker" viewBox="0 0 328 260" fill="none" aria-hidden="true"
